generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  MOTO
  ACCESSORY
  PART
}

model Product {
  id   Int         @id @default(autoincrement())
  type ProductType

  category    String
  subcategory String?

  brand String
  name  String
  slug  String @unique

  condition String?

  shortDescription String?
  description      String?

  price    Decimal  @db.Decimal(10, 2)
  oldPrice Decimal? @db.Decimal(10, 2)

  installmentEnabled Boolean  @default(false)
  installmentCount   Int?
  installmentValue   Decimal? @db.Decimal(10, 2)

  coverUrl String?
  images   String[] @default([])
  videoUrl String?

  specs Json?

  badges String[] @default([])

  stockAvailable Boolean @default(true)
  stockQuantity  Int?

  purchasableOnline Boolean @default(false)
  requestQuote      Boolean @default(false)
  testRide          Boolean @default(false)
  whatsapp          Boolean @default(true)

  feedEnabled  Boolean @default(false)
  feedFeatured Boolean @default(false)
  feedOrder    Int?
  feedText     String?

  tags String[] @default([])

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors   ProductColor[]
  variants ProductVariant[]

  @@map("products")
}

model ProductColor {
  id        Int @id @default(autoincrement())
  productId Int

  key  String
  name String
  hex  String

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, key])
  @@map("product_colors")
}

model ProductVariant {
  id        Int  @id @default(autoincrement())
  productId Int
  colorId   Int?

  key   String
  size  String?
  stock Int     @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@unique([productId, key])
  @@map("product_variants")
}
